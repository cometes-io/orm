{
  "name": "@cometes/orm",
  "version": "0.1.8",
  "author": "Cometes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cometes-io/orm.git"
  },
  "homepage": "https://github.com/cometes-io/orm",
  "bugs": {
    "url": "https://github.com/cometes-io/orm/issues"
  },
  "keywords": [
    "orm",
    "database",
    "postgres",
    "redis",
    "cache"
  ],
  "description": "ORM pour simplifer et avoir une base de données plus rapide",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "example": "tsx examples/nodejs/index.ts",
    "example:watch": "tsx watch examples/nodejs/index.ts",
    "example:docker": "docker compose -f examples/docker-compose.yml up --build",
    "example:docker:watch": "docker compose -f examples/docker-compose.yml -f examples/docker-compose.watch.yml up --build --watch",
    "example:docker:migrate": "docker compose -f examples/docker-compose.migrate.yml up --build",
    "migrate": "tsx examples/nodejs/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "ci": "npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  },
  "dependencies": {
    "pg": "^8.22.0",
    "sequelize": "^6.37.8"
  },
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "tests"
  }
}
